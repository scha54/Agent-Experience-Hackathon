# CraveQuest backend configuration — EXAMPLE ONLY.
# Copy to `.env` and fill in real values. NEVER commit a real .env (see .gitignore).
# Values below are placeholders / documented defaults, not secrets.

# --- Decider (Strands Decider 2B) ---
# Decider mode: real | mock  (mock is explicitly labeled, never genuine inference)
DECIDER_MODE=real
# Decider checkpoint/model id (REQUIRED, no default)
DECIDER_MODEL=strands_decider/your-checkpoint-name
# Decider server base URL
STRANDS_DECIDER_API_BASE=http://127.0.0.1:8000
# Optional bearer token for the Decider server (leave blank if the server requires none)
STRANDS_DECIDER_API_KEY=
# Decision call timeout in milliseconds
DECISION_TIMEOUT_MS=5000
# Confidence threshold, must be within 0.0–1.0
DECISION_CONFIDENCE_THRESHOLD=0.5

# --- Amazon Bedrock ---
# Bedrock model id (REQUIRED, no default)
BEDROCK_MODEL_ID=your-bedrock-model-id
# Single source of truth for Bedrock retry count (default 3)
BEDROCK_MAX_RETRIES=3
# Exponential backoff bounds in milliseconds
BEDROCK_BACKOFF_INITIAL_MS=500
BEDROCK_BACKOFF_MAX_MS=8000
# Per-attempt Bedrock timeout in milliseconds
BEDROCK_ATTEMPT_TIMEOUT_MS=30000

# --- Input limits ---
MAX_AVAILABLE_TIME_MINUTES=1440
MAX_SERVINGS=20
MAX_STRING_LEN=200
MAX_LIST_LEN=50
# Request body size cap in bytes (recipe endpoints 65536; global cap handled separately at 262144)
MAX_BODY_BYTES=65536

# --- API / session ---
# Comma-separated list of allowed CORS origins (REQUIRED, no default)
ALLOWED_ORIGINS=http://localhost:5173
# Per-session request limit
MAX_SESSION_REQUESTS=20
# Optional token protecting /api/metrics/summary. Leave blank to disable public exposure.
METRICS_ACCESS_TOKEN=

# --- Strategy tool limits ---
NO_COOK_MAX_PREP_MINUTES=10
QUICK_MAX_EXTRA_INGREDIENTS=5
LEFTOVER_MAX_EXTRA_INGREDIENTS=3
# Max user-facing explanation length
MAX_EXPLANATION_CHARS=600
